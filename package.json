{
  "name": "bambu-printer-mcp",
  "version": "1.1.43",
  "description": "MCP server that prepares models for Bambu Studio: STL and 3MF tools, CLI slicing, 3MF tuning, a knowledge base and a Blender bridge. It never contacts or controls a printer.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMontgomery40/bambu-printer-mcp.git"
  },
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT=streamable-http node dist/index.js",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs tests/**/*.test.mjs",
    "package:mcpb": "npm run build && node scripts/package-mcpb.mjs",
    "version": "node scripts/sync-manifest-version.mjs",
    "kb:check": "node scripts/validate-knowledge.mjs",
    "kb:build": "node scripts/build-knowledge.mjs"
  },
  "bin": {
    "bambu-printer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "knowledge",
    "README.md",
    "CONTRIBUTORS.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "3d-printer",
    "bambu",
    "bambu-lab",
    "bambu-studio",
    "stl",
    "3mf"
  ],
  "author": "David Montgomery",
  "license": "GPL-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.3.1",
    "jszip": "^3.10.2",
    "three": "^0.173.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/three": "^0.173.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^6.0.3"
  }
}
